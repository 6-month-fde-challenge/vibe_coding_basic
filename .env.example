# ---------------------------------------------------------------------------
# Personal Habit & Daily Life Tracker - example environment file
#
# Copy to `.env` and edit. `.env` is git-ignored and must never be committed.
#   cp .env.example .env
# Every value below is optional; the defaults shown are what the app uses when
# the variable is absent.
# ---------------------------------------------------------------------------

# Application environment: development | testing | production
HABIT_APP_ENV=development

# SQLAlchemy database URL. SQLite is the default and needs no server.
# Postgres example: postgresql+psycopg://user:pass@localhost:5432/habits
HABIT_DATABASE_URL=sqlite:///data/habit_tracker.db

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
HABIT_LOG_LEVEL=INFO
HABIT_LOG_DIR=logs

# IANA timezone used for every day boundary, streak and daily report.
HABIT_TIMEZONE=Asia/Kolkata

# Echo SQL to the log. Useful when profiling queries; very noisy otherwise.
HABIT_DB_ECHO=false

# Maximum size (in megabytes) accepted by the data import screen.
HABIT_MAX_UPLOAD_MB=10
